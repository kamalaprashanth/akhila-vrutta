<?xml version="1.0" encoding="utf-8"?>
<!-- Only what the app hands to other apps: photos the camera takes for the vault (Capacitor puts them in the
     app's own Pictures folder) and copies being shared (cache/share, cleared at the next share and on start). -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="camera" path="Pictures/" />
    <cache-path name="share" path="share/" />
</paths>
